<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="L850Manager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:L850Manager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="L850 Manager"
    mc:Ignorable="d">
    <Grid x:Name="WindowRoot" Background="{StaticResource AppBackgroundBrush}" SizeChanged="WindowRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="L850 Manager"
            Background="{StaticResource AppBackgroundBrush}"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="False"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            AlwaysShowHeader="False"
            Background="{StaticResource AppBackgroundBrush}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Overview"
                    IsSelected="True"
                    Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Radio" Tag="radio">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE95A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Cells" Tag="cells">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Messages" Tag="sms">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="EsimNavItem" Content="eSIM" Tag="esim" Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="16,0,12,16" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Ellipse Width="9" Height="9" Fill="{StaticResource AccentMintBrush}" />
                        <TextBlock x:Name="FooterStateText" Foreground="{StaticResource AccentMintBrush}" Text="Modem ready" />
                    </StackPanel>
                    <TextBlock x:Name="FooterNetworkText" Margin="18,0,0,0" Style="{StaticResource SecondaryTextStyle}" Text="Reading network…" />
                </StackPanel>
            </NavigationView.PaneFooter>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
