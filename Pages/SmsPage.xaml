<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.SmsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,32" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid><TextBlock Style="{StaticResource PageTitleStyle}" Text="SMS"/><Button HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Foreground="{StaticResource AccentMintBrush}" Content="New message" Click="NewMessage_Click"/></Grid>
        <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox Margin="16" PlaceholderText="Search messages"/><NavigationView Grid.Row="1" PaneDisplayMode="Top" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"><NavigationView.MenuItems><NavigationViewItem Content="Inbox" IsSelected="True"/><NavigationViewItem Content="Sent"/><NavigationViewItem Content="Drafts"/><NavigationViewItem Content="All"/></NavigationView.MenuItems></NavigationView>
                <ListView x:Name="SmsList" Grid.Row="2" SelectionChanged="SmsList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><StackPanel Width="305" Padding="8" Spacing="5"><Grid><TextBlock FontWeight="SemiBold" Text="{Binding DisplaySender}"/><TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" Text="{Binding DisplayTime}"/></Grid><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding Preview}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                <TextBlock x:Name="MessageCountText" Grid.Row="3" Margin="18,14" Style="{StaticResource SecondaryTextStyle}" Text="Loading messages…"/>
            </Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                <Grid Margin="24,14"><StackPanel Spacing="4"><TextBlock x:Name="ConversationTitleText" Style="{StaticResource SectionTitleStyle}" Text="Select a message"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="SIM message"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Content="Delete" Click="Delete_Click"/></Grid>
                <StackPanel Grid.Row="1" Padding="28,24" Spacing="16"><TextBlock x:Name="ConversationDateText" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="—"/><Border HorizontalAlignment="Left" MaxWidth="620" Background="{StaticResource PanelHoverBrush}" CornerRadius="5" Padding="16,11"><TextBlock x:Name="ConversationBodyText" TextWrapping="Wrap" Text="Messages stored on the SIM will appear here."/></Border><TextBlock x:Name="ConversationTimeText" Style="{StaticResource SecondaryTextStyle}" Text="—"/></StackPanel>
                <Grid Grid.Row="2" Padding="14" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MessageTextBox" MaxLength="160" PlaceholderText="Type a message" TextChanged="MessageTextBox_TextChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><TextBlock x:Name="CharacterCountText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="0 / 160"/><Button Style="{StaticResource PrimaryButtonStyle}" Content="Send" Click="Send_Click"/></StackPanel></Grid>
            </Grid></Border>
        </Grid>
    </Grid>
</Page>
