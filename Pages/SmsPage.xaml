<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.SmsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="32,28,32,40" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups><VisualStateGroup>
            <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters>
                <Setter Target="InboxColumn.Width" Value="*"/><Setter Target="ConversationColumn.Width" Value="0"/>
                <Setter Target="ConversationPanel.(Grid.Row)" Value="1"/><Setter Target="ConversationPanel.(Grid.Column)" Value="0"/><Setter Target="ConversationPanel.Margin" Value="0,12,0,0"/>
                <Setter Target="ConversationRow.Height" Value="Auto"/>
            </VisualState.Setters></VisualState>
            <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050"/></VisualState.StateTriggers><VisualState.Setters>
                <Setter Target="InboxColumn.Width" Value="360"/><Setter Target="ConversationColumn.Width" Value="*"/>
                <Setter Target="ConversationPanel.(Grid.Row)" Value="0"/><Setter Target="ConversationPanel.(Grid.Column)" Value="1"/><Setter Target="ConversationPanel.Margin" Value="0"/>
                <Setter Target="ConversationRow.Height" Value="0"/>
            </VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Grid><StackPanel Spacing="5"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Messages"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Live inbox and locally retained sent messages"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Content="New message" Click="NewMessage_Click"/></Grid>
        <Grid x:Name="SmsPanels" Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition x:Name="InboxColumn" Width="360"/><ColumnDefinition x:Name="ConversationColumn" Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="ConversationRow" Height="0"/></Grid.RowDefinitions>
            <Border MinHeight="560" Style="{StaticResource PanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Margin="14,14,14,8" PlaceholderText="Search messages" TextChanged="SearchBox_TextChanged"/><SelectorBar x:Name="SmsFilter" Grid.Row="1" Margin="10,0" SelectionChanged="SmsFilter_SelectionChanged"><SelectorBarItem Text="Inbox" Tag="inbox" IsSelected="True"/><SelectorBarItem Text="Sent" Tag="sent"/><SelectorBarItem Text="All" Tag="all"/></SelectorBar>
                <ListView x:Name="SmsList" Grid.Row="2" SelectionChanged="SmsList_SelectionChanged"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><StackPanel Padding="12,9" Spacing="5"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding DisplaySender}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{Binding DisplayTime}"/></Grid><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                <TextBlock x:Name="MessageCountText" Grid.Row="3" Margin="18,14" Style="{StaticResource SecondaryTextStyle}" Text="Loading messages…"/>
            </Grid></Border>
            <Border x:Name="ConversationPanel" Grid.Column="1" MinHeight="560" Style="{StaticResource PanelStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
                <Grid Margin="24,14"><StackPanel Spacing="4"><TextBlock x:Name="ConversationTitleText" Style="{StaticResource SectionTitleStyle}" Text="Select a message"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="SIM message"/></StackPanel><Button HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Content="Delete" Click="Delete_Click"/></Grid>
                <StackPanel Grid.Row="1" Padding="28,24" Spacing="16"><TextBlock x:Name="ConversationDateText" HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="—"/><Border HorizontalAlignment="Left" MaxWidth="620" Background="{StaticResource PanelHoverBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="16,11"><TextBlock x:Name="ConversationBodyText" TextWrapping="Wrap" Text="Messages stored on the SIM will appear here."/></Border><TextBlock x:Name="ConversationTimeText" Style="{StaticResource SecondaryTextStyle}" Text="—"/></StackPanel>
                <Grid Grid.Row="2" Padding="14" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="MessageTextBox" MaxLength="160" PlaceholderText="Type a message" TextChanged="MessageTextBox_TextChanged"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><TextBlock x:Name="CharacterCountText" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="0 / 160"/><Button Style="{StaticResource PrimaryButtonStyle}" Content="Send" Click="Send_Click"/></StackPanel></Grid>
            </Grid></Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
