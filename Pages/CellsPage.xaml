<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.CellsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Padding="32,28,32,40" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Spacing="6"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Cells"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Scan serving and neighbor cells, then apply an expert lock"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource QuietButtonStyle}" Content="Scan cells" Click="Scan_Click"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="0"><StackPanel>
   <Grid Height="52" Padding="20,0"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="Available cells"/><TextBlock x:Name="ScanStateText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Not scanned"/></Grid>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"><StackPanel MinWidth="720">
    <Grid Height="40" Background="{StaticResource SubtleSurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="TYPE"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="BAND"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="EARFCN"/><TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="PCI"/><TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="RSRP"/><TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="RSRQ"/></Grid>
    <ListView x:Name="CellList" MinHeight="260" MaxHeight="460" SelectionChanged="CellList_SelectionChanged"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid Height="48"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Margin="20,0" VerticalAlignment="Center" Text="{Binding Role}"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Band}"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Earfcn}"/><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Pci}"/><TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource AccentMintBrush}" Text="{Binding Rsrp}"/><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding Rsrq}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
   </StackPanel></ScrollViewer>
  </StackPanel></Border>
  <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="22"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="EARFCN"/><NumberBox x:Name="EarfcnBox" SpinButtonPlacementMode="Compact"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="PCI (optional)"/><NumberBox x:Name="PciBox" SpinButtonPlacementMode="Compact"/></StackPanel><Button Grid.Column="2" VerticalAlignment="Bottom" Style="{StaticResource QuietButtonStyle}" Content="Clear lock" Click="Clear_Click"/><Button Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Content="Apply lock" Click="Apply_Click"/></Grid></Border>
 </Grid></ScrollViewer>
</Page>
