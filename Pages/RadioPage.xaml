<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.RadioPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Padding="32,28,32,40" RowSpacing="16">
  <VisualStateManager.VisualStateGroups><VisualStateGroup>
   <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="ModeColumn.Width" Value="*"/><Setter Target="BandsColumn.Width" Value="0"/><Setter Target="BandsPanel.(Grid.Row)" Value="1"/><Setter Target="BandsPanel.(Grid.Column)" Value="0"/><Setter Target="BandsPanel.Margin" Value="0,12,0,0"/><Setter Target="BandsRow.Height" Value="Auto"/></VisualState.Setters></VisualState>
   <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="ModeColumn.Width" Value="4*"/><Setter Target="BandsColumn.Width" Value="8*"/><Setter Target="BandsPanel.(Grid.Row)" Value="0"/><Setter Target="BandsPanel.(Grid.Column)" Value="1"/><Setter Target="BandsPanel.Margin" Value="0"/><Setter Target="BandsRow.Height" Value="0"/></VisualState.Setters></VisualState>
  </VisualStateGroup></VisualStateManager.VisualStateGroups>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Spacing="6"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Radio"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Network technology and LTE band preferences"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource QuietButtonStyle}" Content="Refresh" Click="Refresh_Click"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="20,14"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentMintBrush}"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="CurrentModeText" FontWeight="SemiBold" Text="Reading radio configuration…"/><TextBlock x:Name="CurrentBandsText" Style="{StaticResource SecondaryTextStyle}" Text="Please wait" TextWrapping="Wrap"/></StackPanel><ProgressRing x:Name="StatusProgress" Grid.Column="2" Width="20" Height="20" IsActive="True"/></Grid></Border>
  <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ModeColumn" Width="4*"/><ColumnDefinition x:Name="BandsColumn" Width="8*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="BandsRow" Height="0"/></Grid.RowDefinitions>
   <Border Style="{StaticResource PanelStyle}" Padding="24"><StackPanel Spacing="22"><StackPanel Spacing="5"><TextBlock Style="{StaticResource EyebrowStyle}" Text="Network mode"/><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Preferred technology"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Choose which radio technology the modem may register on." TextWrapping="Wrap"/></StackPanel><RadioButtons x:Name="NetworkModeSelector" SelectedIndex="2" MaxColumns="1"><x:String>3G only</x:String><x:String>4G only</x:String><x:String>3G + 4G automatic</x:String></RadioButtons><Rectangle Height="1" Fill="{StaticResource StrokeBrush}"/><StackPanel Spacing="7"><TextBlock Style="{StaticResource EyebrowStyle}" Text="Registration behavior"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Applying a different mode can interrupt data briefly while the modem registers again." TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
   <Border x:Name="BandsPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="24"><Grid RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="5"><TextBlock Style="{StaticResource EyebrowStyle}" Text="LTE band policy"/><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Allowed bands"/><TextBlock x:Name="BandSelectionHint" Style="{StaticResource SecondaryTextStyle}" Text="Automatic lets the network choose any supported LTE band." TextWrapping="Wrap"/></StackPanel>
    <Border Grid.Row="1" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8"><CheckBox x:Name="BandAny" IsChecked="True" Content="Automatic · all 24 supported bands"/></Border>
    <StackPanel Grid.Row="2" Spacing="6"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="FDD / SDL"/><ItemsControl ItemsSource="{x:Bind FddBands}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="40"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <StackPanel Grid.Row="3" Spacing="6"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="TDD"/><ItemsControl ItemsSource="{x:Bind TddBands}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" ItemHeight="40"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    <Grid Grid.Row="4"><TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="24 validated bands · verified with modem readback."/><Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Apply changes" Click="Apply_Click"/></Grid>
   </Grid></Border>
  </Grid>
 </Grid></ScrollViewer>
</Page>
