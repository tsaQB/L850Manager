<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.RadioPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Padding="40,28,40,40" RowSpacing="18">
  <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="ModeColumn.Width" Value="*"/><Setter Target="BandsColumn.Width" Value="0"/><Setter Target="BandsPanel.(Grid.Row)" Value="1"/><Setter Target="BandsPanel.(Grid.Column)" Value="0"/><Setter Target="BandsPanel.Margin" Value="0,12,0,0"/><Setter Target="BandsRow.Height" Value="Auto"/></VisualState.Setters></VisualState><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="ModeColumn.Width" Value="4*"/><Setter Target="BandsColumn.Width" Value="8*"/><Setter Target="BandsPanel.(Grid.Row)" Value="0"/><Setter Target="BandsPanel.(Grid.Column)" Value="1"/><Setter Target="BandsPanel.Margin" Value="0"/><Setter Target="BandsRow.Height" Value="0"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Spacing="6"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Radio"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Network technology and LTE band preferences"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource QuietButtonStyle}" Content="Refresh" Click="Refresh_Click"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="20,14"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#1838D6A0" CornerRadius="21"><FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentMintBrush}" Glyph="&#xE95A;"/></Border><StackPanel Grid.Column="1" Spacing="3"><TextBlock x:Name="CurrentModeText" FontWeight="SemiBold" Text="Reading radio configuration…"/><TextBlock x:Name="CurrentBandsText" Style="{StaticResource SecondaryTextStyle}" Text="Please wait" TextWrapping="Wrap"/></StackPanel><ProgressRing x:Name="StatusProgress" Grid.Column="2" Width="22" Height="22" IsActive="True"/></Grid></Border>
  <Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition x:Name="ModeColumn" Width="4*"/><ColumnDefinition x:Name="BandsColumn" Width="8*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="BandsRow" Height="0"/></Grid.RowDefinitions>
   <Border Style="{StaticResource PanelStyle}" Padding="24"><StackPanel Spacing="22"><StackPanel Spacing="5"><TextBlock Style="{StaticResource EyebrowStyle}" Text="NETWORK MODE"/><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Preferred technology"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Choose which radio technology the modem may register on." TextWrapping="Wrap"/></StackPanel><RadioButtons x:Name="NetworkModeSelector" SelectedIndex="2" MaxColumns="1"><x:String>3G only</x:String><x:String>4G only</x:String><x:String>3G + 4G automatic</x:String></RadioButtons><Rectangle Height="1" Fill="{StaticResource StrokeBrush}"/><StackPanel Spacing="7"><TextBlock Style="{StaticResource EyebrowStyle}" Text="BEHAVIOR"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Applying a different mode can interrupt data briefly while the modem registers again." TextWrapping="Wrap"/></StackPanel></StackPanel></Border>
   <Border x:Name="BandsPanel" Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="24"><Grid RowSpacing="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="5"><TextBlock Style="{StaticResource EyebrowStyle}" Text="LTE BANDS"/><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Allowed bands"/><TextBlock x:Name="BandSelectionHint" Style="{StaticResource SecondaryTextStyle}" Text="Automatic lets the network choose any supported LTE band." TextWrapping="Wrap"/></StackPanel><Border Grid.Row="1" Background="{StaticResource SubtleSurfaceBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8"><CheckBox x:Name="BandAny" IsChecked="True" Content="Automatic · all supported bands"/></Border><Grid Grid.Row="2" RowSpacing="10" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><CheckBox x:Name="Band1" Content="B1 · 2100 MHz"/><CheckBox x:Name="Band3" Grid.Column="1" Content="B3 · 1800 MHz"/><CheckBox x:Name="Band5" Grid.Column="2" Content="B5 · 850 MHz"/><CheckBox x:Name="Band7" Grid.Row="1" Content="B7 · 2600 MHz"/><CheckBox x:Name="Band8" Grid.Row="1" Grid.Column="1" Content="B8 · 900 MHz"/><CheckBox x:Name="Band20" Grid.Row="1" Grid.Column="2" Content="B20 · 800 MHz"/><CheckBox x:Name="Band28" Grid.Row="2" Content="B28 · 700 MHz"/><CheckBox x:Name="Band40" Grid.Row="2" Grid.Column="1" Content="B40 · 2300 MHz"/><CheckBox x:Name="Band41" Grid.Row="2" Grid.Column="2" Content="B41 · 2500 MHz"/></Grid><Grid Grid.Row="3"><TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Changes are verified with modem readback."/><Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Apply radio settings" Click="Apply_Click"/></Grid></Grid></Border>
  </Grid>
 </Grid></ScrollViewer>
</Page>
