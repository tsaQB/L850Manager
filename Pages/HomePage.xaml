<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Padding="32,28,32,40" RowSpacing="16">
  <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="HeroColumn.Width" Value="*"/><Setter Target="ChartColumn.Width" Value="0"/><Setter Target="SignalChart.(Grid.Row)" Value="1"/><Setter Target="SignalChart.(Grid.Column)" Value="0"/><Setter Target="SignalChart.Margin" Value="0,12,0,0"/><Setter Target="ChartRow.Height" Value="Auto"/></VisualState.Setters></VisualState><VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1080"/></VisualState.StateTriggers><VisualState.Setters><Setter Target="HeroColumn.Width" Value="5*"/><Setter Target="ChartColumn.Width" Value="7*"/><Setter Target="SignalChart.(Grid.Row)" Value="0"/><Setter Target="SignalChart.(Grid.Column)" Value="1"/><Setter Target="SignalChart.Margin" Value="0"/><Setter Target="ChartRow.Height" Value="0"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel Spacing="5"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Overview"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Live cellular status and radio health"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8"><Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource AccentMintBrush}"/><TextBlock x:Name="UpdatedText" Style="{StaticResource SecondaryTextStyle}" Text="Starting…"/></StackPanel></Grid>
  <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition x:Name="HeroColumn" Width="5*"/><ColumnDefinition x:Name="ChartColumn" Width="7*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition x:Name="ChartRow" Height="0"/></Grid.RowDefinitions>
   <Border Style="{StaticResource PanelStyle}" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Spacing="9"><TextBlock Style="{StaticResource EyebrowStyle}" Text="Current connection"/><TextBlock x:Name="ProviderText" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" Text="Detecting modem…"/><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="7" Height="7" Fill="{StaticResource AccentMintBrush}"/><TextBlock x:Name="ConnectionStateText" Foreground="{StaticResource AccentMintBrush}" Text="Starting"/></StackPanel></StackPanel><Rectangle Grid.Row="1" Fill="{StaticResource StrokeBrush}"/><Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Technology"/><TextBlock x:Name="TechnologyText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="LTE band"/><TextBlock x:Name="HeroBandText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel><StackPanel Grid.Column="2" Spacing="4"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Signal"/><TextBlock x:Name="HeroRsrpText" FontSize="17" FontWeight="SemiBold" Text="—"/></StackPanel></Grid></Grid></Border>
   <Border x:Name="SignalChart" Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="22"><Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="240"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Signal (RSRP)"/><TextBlock x:Name="CurrentRsrpText" HorizontalAlignment="Right" Style="{StaticResource MetricValueStyle}" Text="—"/></Grid><Viewbox Grid.Row="1" Stretch="Fill"><Canvas Width="700" Height="240"><Line X1="42" Y1="20" X2="42" Y2="214" Stroke="{StaticResource StrokeBrush}"/><Line X1="42" Y1="214" X2="690" Y2="214" Stroke="{StaticResource StrokeBrush}"/><Line X1="42" Y1="68" X2="690" Y2="68" Stroke="#243036" StrokeDashArray="3,5"/><Line X1="42" Y1="116" X2="690" Y2="116" Stroke="#243036" StrokeDashArray="3,5"/><Line X1="42" Y1="164" X2="690" Y2="164" Stroke="#243036" StrokeDashArray="3,5"/><Polyline x:Name="SignalLine" Stroke="{StaticResource AccentMintBrush}" StrokeThickness="2.5"/></Canvas></Viewbox><Grid Grid.Row="2"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="-60 s"/><TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="-30 s"/><TextBlock HorizontalAlignment="Right" Style="{StaticResource SecondaryTextStyle}" Text="Now"/></Grid></Grid></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource PanelStyle}"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
   <StackPanel Margin="20,16" Spacing="6"><TextBlock Style="{StaticResource EyebrowStyle}" Text="RSRP"/><TextBlock x:Name="RsrpText" Style="{StaticResource MetricValueStyle}" Text="—"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Signal power"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="20,16" Spacing="6"><TextBlock Style="{StaticResource EyebrowStyle}" Text="RSRQ"/><TextBlock x:Name="RsrqText" Style="{StaticResource MetricValueStyle}" Text="—"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Signal quality"/></StackPanel>
   <StackPanel Grid.Column="2" Margin="20,16" Spacing="6"><TextBlock Style="{StaticResource EyebrowStyle}" Text="SINR"/><TextBlock x:Name="SinrText" Style="{StaticResource MetricValueStyle}" Text="—"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Interference ratio"/></StackPanel>
   <StackPanel Grid.Row="1" Margin="20,16" Spacing="6"><TextBlock Style="{StaticResource EyebrowStyle}" Text="EARFCN"/><TextBlock x:Name="EarfcnText" Style="{StaticResource MetricValueStyle}" Text="—"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="LTE channel"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="1" Margin="20,16" Spacing="6"><TextBlock Style="{StaticResource EyebrowStyle}" Text="PCI"/><TextBlock x:Name="PciText" Style="{StaticResource MetricValueStyle}" Text="—"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Physical cell ID"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="2" Margin="20,16" Spacing="6"><TextBlock Style="{StaticResource EyebrowStyle}" Text="APN"/><TextBlock x:Name="ApnText" Style="{StaticResource MetricValueStyle}" Text="—" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="FirmwareText" Style="{StaticResource SecondaryTextStyle}" Text="Firmware —" TextTrimming="CharacterEllipsis"/></StackPanel>
   <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Left" Fill="{StaticResource StrokeBrush}"/><Rectangle Grid.Column="2" Width="1" HorizontalAlignment="Left" Fill="{StaticResource StrokeBrush}"/><Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}"/>
  </Grid></Border>
  <Border Grid.Row="3" Style="{StaticResource PanelStyle}"><StackPanel><Grid Height="54" Padding="20,0"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="Serving and neighbor cells"/><TextBlock x:Name="CellCountText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Waiting for scan"/></Grid><ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"><StackPanel MinWidth="760"><Grid Height="40" Background="{StaticResource SubtleSurfaceBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="TYPE"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="BAND"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="EARFCN"/><TextBlock Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="PCI"/><TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="RSRP"/><TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="RSRQ"/><TextBlock Grid.Column="6" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="SINR"/></Grid><ListView x:Name="CellList" MaxHeight="230"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsHitTestVisible" Value="False"/></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid Height="46"><Grid.ColumnDefinitions><ColumnDefinition Width="1.5*"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Margin="20,0" VerticalAlignment="Center" Text="{Binding Role}"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Band}"/><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Earfcn}"/><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Pci}"/><TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource AccentMintBrush}" Text="{Binding Rsrp}"/><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding Rsrq}"/><TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding Sinr}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></ScrollViewer></StackPanel></Border>
 </Grid></ScrollViewer>
</Page>
