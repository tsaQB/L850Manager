<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="32,28,32,40" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel Spacing="5"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Diagnostics"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Transport health, modem state, and sanitized runtime activity"/></StackPanel><Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource QuietButtonStyle}" Content="Refresh" Click="Refresh_Click"/></Grid>
  <Border Grid.Row="1" Style="{StaticResource PanelStyle}"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions>
   <TextBlock Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="MBIM interface"/><TextBlock x:Name="MbimStateText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Checking"/><TextBlock x:Name="MbimDetailText" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Cellular"/>
   <TextBlock Grid.Row="1" Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="AT transport"/><TextBlock x:Name="AtStateText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Checking"/><TextBlock x:Name="AtDetailText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Detecting port"/>
   <TextBlock Grid.Row="2" Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Cell lock"/><TextBlock x:Name="LockStateText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Checking"/><TextBlock x:Name="LockDetailText" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="NVM protocol"/>
   <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}"/><Rectangle Grid.Row="2" Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}"/>
  </Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Padding="20,0"><TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="Activity log"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Sensitive identifiers are redacted"/></Grid><TextBox x:Name="LogTextBox" Grid.Row="1" Margin="12,0,12,12" Padding="12" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono" FontSize="12" Text="No activity yet."/></Grid></Border>
 </Grid>
</Page>
