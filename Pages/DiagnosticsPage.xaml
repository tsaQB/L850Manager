<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.DiagnosticsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40,28,40,32" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="6"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Diagnostics"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Device, transport and runtime health"/></StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelStyle}" Padding="18"><StackPanel Spacing="8"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="MBIM interface"/><TextBlock x:Name="MbimStateText" Style="{StaticResource SectionTitleStyle}" Text="Checking"/><TextBlock x:Name="MbimDetailText" Foreground="{StaticResource AccentMintBrush}" Text="Cellular"/></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="18"><StackPanel Spacing="8"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="AT transport"/><TextBlock x:Name="AtStateText" Style="{StaticResource SectionTitleStyle}" Text="Checking"/><TextBlock x:Name="AtDetailText" Foreground="{StaticResource AccentMintBrush}" Text="Detecting port"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="18"><StackPanel Spacing="8"><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Cell lock state"/><TextBlock x:Name="LockStateText" Style="{StaticResource SectionTitleStyle}" Text="Checking"/><TextBlock x:Name="LockDetailText" Foreground="{StaticResource AccentMintBrush}" Text="NVM protocol"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Activity log"/><Button HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Content="Refresh" Click="Refresh_Click"/></Grid><TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,16,0,0" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono" Text="No activity yet."/></Grid></Border>
    </Grid>
</Page>
