<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="L850Manager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1280"
            Padding="32,28,32,40"
            HorizontalAlignment="Left"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="5">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Polling behavior and application information" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsPrimaryColumn" Width="3*" />
                    <ColumnDefinition x:Name="SettingsSecondaryColumn" Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="SettingsStackRow" Height="0" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="92" />
                            <RowDefinition Height="92" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="22,19,22,17" Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Polling" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Changes apply on the next page refresh." />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="22,0,16,0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="Overview refresh" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Updates radio values and the 60-second signal chart" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,22,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <NumberBox
                                    x:Name="OverviewIntervalBox"
                                    Width="112"
                                    Height="40"
                                    Minimum="2"
                                    Maximum="60"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="OverviewInterval_ValueChanged" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="sec" />
                            </StackPanel>
                            <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="22,0,16,0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock FontWeight="SemiBold" Text="SMS inbox polling" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Checks SIM storage for newly received messages" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,22,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                                <NumberBox
                                    x:Name="SmsIntervalBox"
                                    Width="112"
                                    Height="40"
                                    Minimum="2"
                                    Maximum="60"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SmsInterval_ValueChanged" />
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="sec" />
                            </StackPanel>
                            <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="AboutPanel" Grid.Column="1" Style="{StaticResource PanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Padding="22,19,22,17" Spacing="4">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Application" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Local modem control workspace" />
                        </StackPanel>

                        <Grid Grid.Row="1" Padding="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Product" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="L850 Manager" />
                            <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}" />
                        </Grid>

                        <Grid Grid.Row="2" Padding="22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Version" />
                            <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" />
                            <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="3" Padding="22,17,22,20" Spacing="5">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Privacy" />
                            <TextBlock Text="Modem identifiers and eSIM activation data are never written to application logs." TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
