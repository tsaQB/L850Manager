<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="L850Manager.Pages.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Padding="32,28,32,40" RowSpacing="16" MaxWidth="960" HorizontalAlignment="Left">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="5"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Application behavior and information"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource PanelStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="72"/></Grid.RowDefinitions>
   <StackPanel Margin="20,0" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Overview refresh interval"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="How often live radio values are refreshed"/></StackPanel><NumberBox x:Name="OverviewIntervalBox" Grid.Column="1" Margin="16" ValueChanged="OverviewInterval_ValueChanged" Minimum="2" Maximum="60" SpinButtonPlacementMode="Compact" Header="Seconds"/>
   <StackPanel Grid.Row="1" Margin="20,0" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="SMS polling interval"/><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="How often SIM storage is checked for new messages"/></StackPanel><NumberBox x:Name="SmsIntervalBox" Grid.Row="1" Grid.Column="1" Margin="16" ValueChanged="SmsInterval_ValueChanged" Minimum="2" Maximum="60" SpinButtonPlacementMode="Compact" Header="Seconds"/>
   <Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}"/>
  </Grid></Border>
  <Border Grid.Row="2" Style="{StaticResource PanelStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="52"/><RowDefinition Height="52"/></Grid.RowDefinitions><TextBlock Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Application"/><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="L850 Manager"/><TextBlock Grid.Row="1" Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Version"/><TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="1.2.0"/><TextBlock Grid.Row="2" Margin="20,0" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Privacy"/><TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="Modem identifiers and eSIM activation data are never written to logs" TextWrapping="Wrap"/><Rectangle Grid.Row="1" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}"/><Rectangle Grid.Row="2" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Fill="{StaticResource StrokeBrush}"/></Grid></Border>
 </Grid></ScrollViewer>
</Page>
