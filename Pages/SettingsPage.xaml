<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="L850Manager.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:L850Manager.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40,28,40,32" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="5"><TextBlock Style="{StaticResource PageTitleStyle}" Text="Settings" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Appearance, polling, and application behavior"/></StackPanel>
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="20" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="18"><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Appearance"/><ToggleSwitch Header="Use system theme" OffContent="Dark" OnContent="System"/><Rectangle Height="1" Fill="{StaticResource StrokeBrush}"/><TextBlock Style="{StaticResource SectionTitleStyle}" Text="Polling"/><NumberBox Header="Overview refresh interval (seconds)" Value="5" Minimum="2" Maximum="60"/><ToggleSwitch Header="Pause polling while editing lock values" IsOn="True"/></StackPanel>
        </Border>
    </Grid>
</Page>
